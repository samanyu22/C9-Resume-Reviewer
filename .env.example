# HireSense Supabase Environment Variables
VITE_SUPABASE_URL=https://vglqudbftkybegdrqdec.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Server-only (never expose to client)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# AI Service Environment Variables (Gemini primary, OpenAI fallback)
OPENAI_API_KEY=your_openai_api_key_here
# Supports multiple comma-separated keys (e.g. key1,key2,key3) for automatic failover & credit rotation
GEMINI_API_KEY=your_gemini_api_key_1,your_gemini_api_key_2

# Configurable Model IDs & Voice
LLM_MODEL_PRIMARY=gemini-3.8-flash
LLM_MODEL_FALLBACK=gpt-4o-mini
STT_MODEL=gemini-3.8-flash
TTS_MODEL=tts-1
TTS_VOICE=onyx

# Optional AI Service URL (defaults to http://127.0.0.1:8000)
AI_SERVICE_URL=http://127.0.0.1:8000
